NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/client_management_portal?retryWrites=true&w=majority
DNS_SERVERS=
CLIENT_URL=http://localhost:5173
LOG_LEVEL=debug
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
PROJECT_FILE_STORAGE_ROOT=./storage/project-files
